# Database
# In production, prefer the complete URL supplied by the managed PostgreSQL
# provider. Leave it empty in local development to use the DB_* values below.
DATABASE_URL=
DB_NAME=mine_crm
DB_USER=postgres
DB_PASSWORD=replace-with-a-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# JWT signing (generate at least 32 random bytes for production)
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Kept for backward-compatible configuration; session access tokens use the
# shorter AUTH_ACCESS_TOKEN_EXPIRE_MINUTES value below.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Authentication
APP_ENV=development
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_JWT_ISSUER=mine-crm-ai
AUTH_JWT_AUDIENCE=mine-crm-ai-api
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Keep the refresh token host-only when possible by leaving this empty.
AUTH_COOKIE_DOMAIN=
# Required only when frontend and API use distinct subdomains. Example:
# .mine-crm.example for app.mine-crm.example + api.mine-crm.example
AUTH_CSRF_COOKIE_DOMAIN=
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
BACKEND_TRUSTED_HOSTS=localhost,127.0.0.1

# Optional local-only helper. Never enable it in production. With the default
# false value, tokens are kept only in the in-process development mail outbox.
AUTH_DEV_EXPOSE_TOKENS=false

# Required when APP_ENV=production. In local development, messages are held in
# a private in-memory outbox and are never printed to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# AI assistant. Local mode is useful, deterministic and makes no paid request.
# To opt in later, use AI_PROVIDER=openai and set the API key on the backend.
AI_ENABLED=true
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=50
# 5 USD, stored as micro-US-dollars to preserve sub-cent usage.
AI_MONTHLY_BUDGET_MICROUSD=5000000
AI_MAX_INPUT_CHARS=4000
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=700
AI_OPENAI_TIMEOUT_SECONDS=30
AI_COPILOT_MEMORY_TTL_MINUTES=30
AI_COPILOT_MAX_TURNS=8
AI_COPILOT_MAX_SESSIONS=5000
AI_COPILOT_MEMORY_MESSAGE_CHARS=2000
# Current estimates for the default model, in micro-USD per 1M tokens.
# Update both values when OPENAI_MODEL or its public pricing changes.
AI_INPUT_COST_PER_MILLION_MICROUSD=200000
AI_OUTPUT_COST_PER_MILLION_MICROUSD=1200000
