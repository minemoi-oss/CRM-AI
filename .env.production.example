# Mine CRM AI backend production template. Never commit real values.
APP_ENV=production
DATABASE_URL=postgresql://minecrm:replace-password@db.mine-crm.example:5432/mine_crm?sslmode=require
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

SECRET_KEY=replace-with-at-least-32-random-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_JWT_ISSUER=mine-crm-ai
AUTH_JWT_AUDIENCE=mine-crm-ai-api
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Refresh token stays host-only on api.mine-crm.example.
AUTH_COOKIE_DOMAIN=
# Readable CSRF cookie is shared with app.mine-crm.example.
AUTH_CSRF_COOKIE_DOMAIN=.mine-crm.example
AUTH_DEV_EXPOSE_TOKENS=false
AUTH_ALLOWED_ORIGINS=https://app.mine-crm.example
FRONTEND_URL=https://app.mine-crm.example
BACKEND_URL=https://api.mine-crm.example
BACKEND_TRUSTED_HOSTS=api.mine-crm.example

SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-username
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM_EMAIL=security@mine-crm.example
SMTP_USE_TLS=true

AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=replace-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=25
AI_MONTHLY_BUDGET_MICROUSD=5000000
AI_MAX_INPUT_CHARS=4000
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=700
AI_OPENAI_TIMEOUT_SECONDS=30
AI_COPILOT_MEMORY_TTL_MINUTES=30
AI_COPILOT_MAX_TURNS=8
AI_COPILOT_MAX_SESSIONS=5000
AI_COPILOT_MEMORY_MESSAGE_CHARS=2000
AI_INPUT_COST_PER_MILLION_MICROUSD=200000
AI_OUTPUT_COST_PER_MILLION_MICROUSD=1200000

# Runtime process. Keep one worker until Copilot memory moves to Redis.
PORT=8000
# List only the reverse-proxy IPs or CIDR ranges that connect directly to Uvicorn.
# Never use *, because client-supplied forwarding headers would then be trusted.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=info

# Persistent encrypted storage used by scripts/backup_postgres.py.
BACKUP_DIRECTORY=/var/backups/mine-crm
BACKUP_RETENTION_DAYS=14
